# Optional dev flag (default: unset/false). Must NEVER be set in production to prevent leaking codes.
ALLOW_DEV_OTP_LOG=

# GitHub OAuth credentials (set in Convex Dashboard)
# Set Authorization callback URL in GitHub developer settings to:
# https://<your-convex-deployment>.convex.site/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email OTP Delivery (resend or brevo)
EMAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=

# Convex configuration
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=

# Canonical Production URL (Vercel production URL; app fails at startup if missing in production)
SITE_URL=
VITE_CONVEX_URL=